# systemd USER unit for the always-on meta-notes-ui. See deploy/always-on.md.
# Copy to ~/.config/systemd/user/meta-notes-ui.service and replace the four
# placeholders: NODE, NOTES, NODE_BIN_DIR and META_NOTES_BIN_DIR. On vesta:
#   NODE     = the output of `command -v node`
#   NOTES    = /srv/shared/work/notes-work/notes
#   NODE_BIN_DIR = the directory of NODE
#   META_NOTES_BIN_DIR = the directory of `command -v meta-notes`
[Unit]
Description=meta-notes-ui (always-on notes UI)
After=network.target

[Service]
# `current` is the build deploy/update.sh last finished (see deploy/always-on.md).
WorkingDirectory=%h/.local/share/meta-notes-ui/current
# A user unit has a minimal PATH; the server runs `meta-notes` and needs it here.
Environment=PATH=META_NOTES_BIN_DIR:NODE_BIN_DIR:/usr/local/bin:/usr/bin:/bin
# The last three flags enable the Message button (send to the notes advisor as the human);
# drop them to run without bridle (all or none of --bridle-url and --bridle-token-file).
# --push-contact turns on Web Push; replace the placeholder with your own mailto: or https: URL
# (the push services want a way to reach the sender). Drop the flag to run without push.
ExecStart=NODE dist/server/index.js --root NOTES --port 7480 --host 127.0.0.1 --token-file NOTES/.meta-notes-cache/ui/token --bridle-url http://127.0.0.1:7404 --bridle-token-file /srv/shared/work/notes-work/.bridle/tokens/human --bridle-to external:advisor --push-contact mailto:you@example.com
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
